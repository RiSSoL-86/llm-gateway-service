# --- Base ---
SECRET_KEY=dev-only-change-me-to-a-random-32-character-secret-key
DEBUG=true
ENVIRONMENT=local
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=
PROJECT_NAME=llm-gateway-service

# --- Server (compose, uvicorn, Caddy) ---
PORT=8000
WEB_CONCURRENCY=1
# Server host for the HTTPS certificate, e.g. 1-2-3-4.sslip.io (from SSM)
PUBLIC_HOST=localhost

# --- Database (PostgreSQL, admin only) ---
POSTGRES_DB=llm_gateway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Logs: CloudWatch through the Docker awslogs driver ---
AWS_REGION=us-east-1
LOG_GROUP=/llm-gateway-service/servers
LOG_STREAM=llm-gateway-1

# --- OpenRouter (upstream) ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Real OpenRouter key: the gateway puts it instead of the client key
OPENROUTER_API_KEY=
UPSTREAM_CONNECT_TIMEOUT=10
UPSTREAM_READ_TIMEOUT=300
UPSTREAM_MAX_CONNECTIONS=1000

# --- Our keys for clients: key=client-name, comma separated ---
GATEWAY_KEYS=
